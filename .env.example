# Copy to .env and adjust. Every value has a working default.
# .env is gitignored — never commit a key.

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
# mock       = offline, deterministic, free. Use this for load testing.
# openrouter = real models. Use this when the behaviour of a real model matters.
MODEL_PROVIDER=mock

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30

CHAT_MODEL=openai/gpt-4o-mini
CLASSIFIER_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# Shown in your OpenRouter activity log, so you can see which app spent what.
OPENROUTER_REFERER=https://masterschool.com
OPENROUTER_TITLE=Alton Support Triage

# ---------------------------------------------------------------------------
# Mock provider latency, in seconds
# ---------------------------------------------------------------------------
# These make the service slow on purpose. Lowering them hides the problem
# instead of solving it. Ignored when MODEL_PROVIDER=openrouter.
CLASSIFY_LATENCY=0.06
EMBED_LATENCY_PER_ITEM=0.018
GENERATE_BASE_LATENCY=0.70
TOOL_LATENCY=0.25

# ---------------------------------------------------------------------------
# Currency
# ---------------------------------------------------------------------------
# Providers bill in USD. The service reports cost_eur, converted once using
# this rate. A pinned assumption, not a live rate.
EUR_PER_USD=0.92

# ---------------------------------------------------------------------------
# Fallback pricing, USD per 1000 tokens
# ---------------------------------------------------------------------------
# Used when the provider does not report actual spend. OpenRouter does report
# it, so in openrouter mode these are rarely used — but on mock, every cost
# figure comes from here.
PRICE_GENERATE_USD_PER_1K=0.0150
PRICE_CLASSIFY_USD_PER_1K=0.0004
PRICE_EMBED_USD_PER_1K=0.0002

RETRIEVAL_TOP_K=3

# ---------------------------------------------------------------------------
# Fault injection — all off by default, needed from Sprint 3
# ---------------------------------------------------------------------------
FAULT_MODEL_ERROR_RATE=0.0
FAULT_MODEL_EXTRA_LATENCY=0.0
FAULT_RETRIEVAL_DOWN=false
FAULT_TOOL_ERROR_RATE=0.0
FAULT_TOOL_EXTRA_LATENCY=0.0
